{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "r5r5-gateway-connector-only",
    "namespace": "trendai-gateway"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "r5r5-gateway-connector"
      }
    },
    "policyTypes": [
      "Ingress",
      "Egress"
    ],
    "ingress": [],
    "egress": [
      {
        "to": [
          {
            "podSelector": {
              "matchLabels": {
                "app.kubernetes.io/component": "gateway",
                "app.kubernetes.io/instance": "trendai-gateway"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 8080
          },
          {
            "protocol": "TCP",
            "port": 8081
          }
        ]
      },
      {
        "ports": [
          {
            "protocol": "UDP",
            "port": 53
          },
          {
            "protocol": "TCP",
            "port": 53
          },
          {
            "protocol": "UDP",
            "port": 7844
          },
          {
            "protocol": "TCP",
            "port": 7844
          }
        ]
      }
    ]
  }
}
